      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(maintainer_cockpit_analysis_provider_failures_total{maintainer_cockpit_collection=~\"${collection:regex}\",gen_ai_provider_name=~\"${provider:regex}\",gen_ai_request_model=~\"${model:regex}\"}[$__range])) or vector(0)",
