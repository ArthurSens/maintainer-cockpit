          "editorMode": "code",
          "expr": "sum(rate(gen_ai_client_operation_duration_seconds_count{maintainer_cockpit_collection=~\"${collection:regex}\",gen_ai_provider_name=~\"${provider:regex}\",gen_ai_request_model=~\"${model:regex}\",error_type=\"\"}[$__rate_interval]))",
