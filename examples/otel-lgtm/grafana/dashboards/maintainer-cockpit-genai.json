      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(gen_ai_client_operation_duration_seconds_bucket{maintainer_cockpit_collection=~\"${collection:regex}\",gen_ai_provider_name=~\"${provider:regex}\",gen_ai_request_model=~\"${model:regex}\"}[$__range])))",
